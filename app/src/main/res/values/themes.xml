<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Astra" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:colorControlActivated">@color/amber</item>
        <item name="android:alertDialogTheme">@style/Theme.Astra.Dialog</item>
        <item name="android:popupMenuStyle">@style/Astra.PopupMenu</item>
    </style>

    <style name="Theme.Astra.Player" parent="Theme.Astra">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Astra.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:colorControlActivated">@color/amber</item>
    </style>

    <style name="Astra.PopupMenu" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_dialog</item>
    </style>

    <style name="PlayerIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_round_btn</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text</item>
    </style>

    <style name="PlayerIcon.Small">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:tint">#CCF1F1F3</item>
    </style>
</resources>
