<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/blank"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/audio_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/audio_art"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_thumb"
            android:padding="36dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_audio"
            android:tint="@color/amber" />

        <TextView
            android:id="@+id/audio_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxWidth="320dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:id="@+id/gesture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/amber"
        android:visibility="gone" />

    <TextView
        android:id="@+id/loading_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="64dp"
        android:gravity="center"
        android:text="Preparing subtitle fonts (first launch only)…"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Seek preview: a frame of the target time, placed above the seek bar thumb. -->
    <LinearLayout
        android:id="@+id/seek_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_pill"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/seek_preview_image"
            android:layout_width="176dp"
            android:layout_height="99dp"
            android:background="@drawable/bg_thumb"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/seek_preview_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/center_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_card"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/amber"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/error_close"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_ghost"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Close"
                android:textColor="@color/amber" />

            <TextView
                android:id="@+id/error_skip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Next file"
                android:textColor="#101013"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="22dp">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/PlayerIcon"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/badge_ab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/amber"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/badge_rec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="● REC"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_related"
            style="@style/PlayerIcon"
            android:contentDescription="Related videos"
            android:src="@drawable/ic_playlist"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_shot"
            style="@style/PlayerIcon"
            android:contentDescription="Screenshot"
            android:src="@drawable/ic_camera" />

        <ImageButton
            android:id="@+id/btn_pip"
            style="@style/PlayerIcon"
            android:contentDescription="Picture in picture"
            android:src="@drawable/ic_pip" />

        <ImageButton
            android:id="@+id/btn_more"
            style="@style/PlayerIcon"
            android:contentDescription="More"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_lock"
        style="@style/PlayerIcon"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_pill"
        android:contentDescription="Lock controls"
        android:src="@drawable/ic_unlock" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_controls"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="0:00"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progressDrawable="@drawable/seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />

            <TextView
                android:id="@+id/time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="0:00"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton android:id="@+id/btn_sub" style="@style/PlayerIcon.Small" android:contentDescription="Subtitles" android:src="@drawable/ic_subtitles" />
            <ImageButton android:id="@+id/btn_audio" style="@style/PlayerIcon.Small" android:contentDescription="Audio track" android:src="@drawable/ic_audio" />
            <ImageButton android:id="@+id/btn_prev" style="@style/PlayerIcon" android:contentDescription="Previous" android:src="@drawable/ic_prev" />
            <ImageButton android:id="@+id/btn_rew" style="@style/PlayerIcon" android:contentDescription="Back 10 seconds" android:src="@drawable/ic_rewind" />

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_play"
                android:contentDescription="Play or pause"
                android:src="@drawable/ic_pause"
                android:tint="#101013" />

            <ImageButton android:id="@+id/btn_fwd" style="@style/PlayerIcon" android:contentDescription="Forward 10 seconds" android:src="@drawable/ic_forward" />
            <ImageButton android:id="@+id/btn_next" style="@style/PlayerIcon" android:contentDescription="Next" android:src="@drawable/ic_next" />
            <ImageButton android:id="@+id/btn_speed" style="@style/PlayerIcon.Small" android:contentDescription="Speed" android:src="@drawable/ic_speed" />
            <ImageButton android:id="@+id/btn_ab" style="@style/PlayerIcon.Small" android:contentDescription="A-B repeat" android:src="@drawable/ic_ab" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
